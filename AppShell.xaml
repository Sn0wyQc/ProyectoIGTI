<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SkillSwap.Views"
       x:Class="SkillSwap.AppShell"
       x:Name="thisShell"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="#1E2A6E">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*, Auto" Padding="0,0,10,0">
            <ImageButton Grid.Column="1"
             Command="{Binding ToggleThemeCommand}"
             Source="{AppThemeBinding Light=luna.png, Dark=sol.png}"
             HeightRequest="36"
             WidthRequest="36"
             Padding="8"
             CornerRadius="18"
             BackgroundColor="{AppThemeBinding Light=#E8EAF6, Dark=#30FFFFFF}"
             VerticalOptions="Center"
             Aspect="AspectFit"/>
        </Grid>
    </Shell.TitleView>
    <!-- Header del Flyout -->
    <Shell.FlyoutHeader>
        <VerticalStackLayout Padding="20,40,20,20" BackgroundColor="#3B4CCA" Spacing="6">
            <Frame BackgroundColor="White"
                   CornerRadius="35"
                   HeightRequest="60"
                   WidthRequest="60"
                   HorizontalOptions="Center"
                   Padding="0"
                   HasShadow="False">
                <Label Text="SS"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="#3B4CCA"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Frame>
            <Label Text="SkillSwap"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <Label Text="Exchange. Learn. Grow"
                   TextColor="#B0BEE8"
                   FontSize="12"
                   HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <!-- Login (oculto del menú) -->
    <ShellContent Title="Login"
                  Route="LoginPage"
                  ContentTemplate="{DataTemplate views:LoginPage}"
                  FlyoutItemIsVisible="False"
                  Shell.NavBarIsVisible="False"/>

    <!-- Inicio -->
    <FlyoutItem Title="Inicio">
        <ShellContent Route="FeedPage"
                      ContentTemplate="{DataTemplate views:FeedPage}"/>
    </FlyoutItem>

    <!-- Mensajes -->
    <FlyoutItem Title="Mensajes">
        <ShellContent Route="ChatPage"
                      ContentTemplate="{DataTemplate views:ChatPage}"/>
    </FlyoutItem>

    <!-- Perfil -->
    <FlyoutItem Title="Mi Perfil">
        <ShellContent Route="ProfilePage"
                      ContentTemplate="{DataTemplate views:ProfilePage}"/>
    </FlyoutItem>

</Shell>
