<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SkillSwap.ViewModels"
             x:Class="SkillSwap.Views.PublicarPage"
             x:DataType="vm:FeedViewModel"
             Title="Nueva Publicación">
    
    <Frame Grid.Row="1"
       IsVisible="{Binding MostrandoFormulario}"
       BackgroundColor="White"
       CornerRadius="12"
       Margin="12,5,12,0" 
       Padding="15,10"
       HasShadow="True">
        <VerticalStackLayout Spacing="5">
            <Label Text="Publicar Anuncio"
               FontAttributes="Bold"
               FontSize="16"
               TextColor="Black"/>
            <Entry Placeholder="Título del anuncio"
               Text="{Binding NuevoTitulo}"
               TextColor="Black" 
               PlaceholderColor="#777777"
               BackgroundColor="#F5F5F5"/>

            <Editor Placeholder="Descripción..."
                Text="{Binding NuevaDescripcion}"
                TextColor="Black"
                PlaceholderColor="#777777"
                HeightRequest="60"
                BackgroundColor="#F5F5F5"/>

            <Picker Title="Seleccionar categoría:"
                TitleColor="#555555"
                TextColor="Black" 
                ItemsSource="{Binding Categorias}"
                SelectedItem="{Binding NuevaCategoria}"
                BackgroundColor="#F5F5F5"
                HeightRequest="65"/>

            <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                <Button Text="Guardar"
                    Command="{Binding GuardarPostCommand}"
                    BackgroundColor="#3B4CCA"
                    TextColor="White"
                    CornerRadius="0"
                    HeightRequest="40"
                    HorizontalOptions="FillAndExpand"
                    WidthRequest="120"/>

                <Button Text="Cancelar"
                    Command="{Binding CancelarFormularioCommand}"
                    BackgroundColor="#cccccc"
                    TextColor="Black"
                    CornerRadius="8"
                    HeightRequest="40"
                    HorizontalOptions="FillAndExpand"
                    WidthRequest="120"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Frame>
</ContentPage>