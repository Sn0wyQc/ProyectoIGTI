<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SkillSwap.ViewModels"
             xmlns:models="clr-namespace:SkillSwap.Models"
             x:Class="SkillSwap.Views.FeedPage"
             x:DataType="vm:FeedViewModel"
             Title="Anuncios"
             BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <ScrollView Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,0">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categorias}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Text="{Binding .}"
                                CornerRadius="20"
                                Padding="14,6"
                                FontSize="12"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                BorderWidth="1"
                                BorderColor="Transparent"
                                Clicked="OnCategoriaClicked">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroupList>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Property="Scale" Value="0.95" />
                                                <Setter Property="BorderColor" Value="{StaticResource Primary}" />
                                                <Setter Property="BorderWidth" Value="2" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateGroupList>
                            </VisualStateManager.VisualStateGroups>
                        </Button>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Posts}"
                        Margin="12,10,12,0">
            <CollectionView.EmptyView>
                <Label Text="No hay anuncios aun. Se el primero!"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#999999, Dark=#B0BEE8}"
                       Margin="0,40,0,0"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Post">
                    <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                           CornerRadius="12"
                           Margin="0,0,0,10"
                           Padding="16"
                           HasShadow="True"
                           BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">
                        <VerticalStackLayout Spacing="10">

                            <HorizontalStackLayout Spacing="8">
                                <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="6" Padding="8,3" HasShadow="False">
                                    <Label Text="{Binding Categoria}" TextColor="White" FontSize="11"/>
                                </Frame>
                            </HorizontalStackLayout>

                            <Label Text="{Binding Titulo}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#222222, Dark=White}"/>

                            <Label Text="{Binding Descripcion}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"
                                   LineBreakMode="WordWrap"/>

                            <Label Text="{Binding NombreUsuario, StringFormat='Por: {0}'}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#B0BEE8}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="3"
                Text="+ Publicar anuncio"
                Command="{Binding MostrarFormularioCommand}"
                Margin="12,10,12,20"
                HeightRequest="50"
                BackgroundColor="{StaticResource Primary}"
                BorderWidth="0"
                BorderColor="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="Scale" Value="0.97" />
                                <Setter Property="BorderColor" Value="White" />
                                <Setter Property="BorderWidth" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </VisualStateManager.VisualStateGroups>
        </Button>

    </Grid>
</ContentPage>