<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SkillSwap.ViewModels"
             xmlns:models="clr-namespace:SkillSwap.Models"
             x:Class="SkillSwap.Views.ChatPage"
             x:DataType="vm:ChatViewModel"
             Title="Mensajes"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Barra superior (Row 0) -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light=#1E2A6E, Dark=#0A0A1A}"
              Padding="10,10,10,10"
              ColumnDefinitions="50, *, 50">

            <Button Grid.Column="0"
                    Text="☰"
                    TextColor="White"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    Clicked="OnMenuClicked"/>

            <Label Grid.Column="1"
                   Text="Mensajes"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <Button Grid.Column="2"
                    Text="⚑"
                    TextColor="#FF6B6B"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    Command="{Binding AbrirReporteCommand}"
                    IsVisible="{Binding ContactoSeleccionado}"/>
        </Grid>

        <!-- Selector de contacto (Row 1) -->
        <Frame Grid.Row="1"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
               Padding="12,8"
               HasShadow="True"
               CornerRadius="0"
               BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">
            <Grid ColumnDefinitions="Auto,*">
                <Label Grid.Column="0"
                       Text="Chatear con:"
                       VerticalOptions="Center"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#B0BEE8}"
                       Margin="0,0,10,0"/>
                <Picker Grid.Column="1"
                        ItemsSource="{Binding Contactos}"
                        ItemDisplayBinding="{Binding Nombre}"
                        SelectedItem="{Binding ContactoSeleccionado}"
                        Title="Selecciona un usuario"
                        TextColor="{AppThemeBinding Light=#222222, Dark=White}"
                        TitleColor="{AppThemeBinding Light=#999999, Dark=#666666}"/>
            </Grid>
        </Frame>

        <!-- Mensajes (Row 2) -->
        <CollectionView Grid.Row="2"
                        x:Name="MensajesCollection"
                        ItemsSource="{Binding Mensajes}"
                        Margin="10,8">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="Selecciona un contacto para chatear"
                           TextColor="{AppThemeBinding Light=#aaaaaa, Dark=#555555}"
                           HorizontalOptions="Center"
                           FontSize="14"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Message">
                    <VerticalStackLayout Margin="0,4" Padding="4,0">
                        <Frame BackgroundColor="{StaticResource Primary}"
                               CornerRadius="14"
                               Padding="12,8"
                               MaximumWidthRequest="280"
                               HorizontalOptions="End"
                               HasShadow="False">
                            <VerticalStackLayout>
                                <Label Text="{Binding NombreEmisor}"
                                       TextColor="#ccddff"
                                       FontSize="11"
                                       FontAttributes="Bold"/>
                                <Label Text="{Binding Texto}"
                                       TextColor="White"
                                       FontSize="14"/>
                                <Label Text="{Binding Fecha, StringFormat='{0:HH:mm}'}"
                                       TextColor="#B0BEE8"
                                       FontSize="10"
                                       HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Input mensaje (Row 3) -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
              Padding="12,8">
            <Entry Grid.Column="0"
                   Placeholder="Escribe un mensaje..."
                   Text="{Binding NuevoMensaje}"
                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   PlaceholderColor="{AppThemeBinding Light=#999, Dark=#555}"
                   ReturnCommand="{Binding EnviarMensajeCommand}"
                   VerticalOptions="Center"
                   BackgroundColor="Transparent"/>
            <Button Grid.Column="1"
                    Text="Enviar"
                    Command="{Binding EnviarMensajeCommand}"
                    Margin="8,0,0,0"
                    FontSize="13"
                    HeightRequest="40"/>
        </Grid>

    </Grid>
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Reportar"
             Command="{Binding AbrirReporteCommand}"/>
    </ContentPage.ToolbarItems>
</ContentPage>