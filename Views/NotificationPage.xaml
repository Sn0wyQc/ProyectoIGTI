<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SkillSwap.Views.NotificationPage"
             BackgroundColor="#F5F6FA">

    <VerticalStackLayout Padding="20" Spacing="15">

        <!-- HEADER -->
        <Label Text="Notificaciones"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="#111827"/>

        <!-- LISTA -->
        <CollectionView ItemsSource="{Binding Notificaciones}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <SwipeView>

                        <!-- BOTON ELIMINAR -->
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Execute">
                                <SwipeItem Text="Eliminar"
                                           BackgroundColor="#EF4444"
                                           Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EliminarCommand}"
                                           CommandParameter="{Binding .}" />
                            </SwipeItems>
                        </SwipeView.RightItems>

                        <Frame CornerRadius="18"
                               Padding="15"
                               Margin="0,5"
                               HasShadow="True"
                               BackgroundColor="White">

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12">

                                <!-- ICONO -->
                                <Image Source="{Binding Icono}"
                                       WidthRequest="40"
                                       HeightRequest="40"/>

                                <!-- TEXTO -->
                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4">

                                    <Label Text="{Binding Titulo}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#111827"/>

                                    <Label Text="{Binding Mensaje}"
                                           FontSize="13"
                                           TextColor="#6B7280"/>

                                </VerticalStackLayout>

                                <!-- DERECHA -->
                                <VerticalStackLayout Grid.Column="2"
                                                     Spacing="5"
                                                     HorizontalOptions="End">

                                    <Label Text="{Binding Fecha}"
                                           FontSize="11"
                                           TextColor="#9CA3AF"/>

                                    <BoxView WidthRequest="10"
                                             HeightRequest="10"
                                             CornerRadius="5"
                                             BackgroundColor="#6366F1"
                                             IsVisible="{Binding NoLeida}"
                                             HorizontalOptions="End"/>
                                </VerticalStackLayout>

                            </Grid>

                           
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.MarcarLeidaCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>

                        </Frame>

                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </VerticalStackLayout>
</ContentPage>