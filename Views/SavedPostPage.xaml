<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SkillSwap.ViewModels"
             xmlns:models="clr-namespace:SkillSwap.Models"
             x:Class="SkillSwap.Views.SavedPostPage"
             x:DataType="vm:SavedPostViewModel"
             Title="Guardados"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}">

    <Grid RowDefinitions="Auto,*">

        <!-- Barra superior -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light=#1E2A6E, Dark=#0A0A1A}"
              Padding="10,10,10,10"
              ColumnDefinitions="50, *, 50">
            <Button Grid.Column="0"
                    Text="☰"
                    TextColor="White"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    Clicked="OnMenuClicked"/>
            <Label Grid.Column="1"
                   Text="Guardados"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Lista de posts guardados -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding PostsGuardados}"
                        Margin="12,10,12,0"
                        BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="Aún no tienes anuncios guardados."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#999999, Dark=#B0BEE8}"
                       Margin="0,40,0,0"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Post">
                    <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                           CornerRadius="12"
                           Margin="0"
                           Padding="16"
                           HasShadow="True"
                           BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">
                        <VerticalStackLayout Spacing="6">

                            <!-- Fila: categoría + botón eliminar -->
                            <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center">
                                <Frame Grid.Column="0"
                                       BackgroundColor="#3B4CCA" CornerRadius="6"
                                       Padding="8,3" HasShadow="False"
                                       VerticalOptions="Center" HorizontalOptions="Start">
                                    <Label Text="{Binding Categoria}" TextColor="White" FontSize="11"/>
                                </Frame>
                                <Button Grid.Column="2"
                                        ImageSource="cross.png"
                                        BackgroundColor="Transparent"
                                        Padding="0"
                                        WidthRequest="32"
                                        HeightRequest="28"
                                        VerticalOptions="Center"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SavedPostViewModel}}, Path=EliminarGuardadoCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>

                            <Label Text="{Binding Titulo}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#222222, Dark=White}"/>
                            <Label Text="{Binding Descripcion}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"
                                   LineBreakMode="WordWrap"/>
                            <Label Text="{Binding NombreUsuario, StringFormat='Por: {0}'}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#B0BEE8}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
