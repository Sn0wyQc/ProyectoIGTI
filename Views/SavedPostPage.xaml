<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SkillSwap.ViewModels"
             xmlns:models="clr-namespace:SkillSwap.Models"
             x:Class="SkillSwap.Views.SavedPostPage"
             x:DataType="vm:SavedPostViewModel"
             Title="Anuncios Guardados"
             BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}">

    <Grid>
        <CollectionView ItemsSource="{Binding PostsGuardados}" Margin="12,10,12,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="Aún no tienes anuncios guardados."
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#999999, Dark=#B0BEE8}"
                       Margin="0,40,0,0"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Post">
                    <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                           CornerRadius="12" Padding="16" HasShadow="True"
                           BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Frame BackgroundColor="{StaticResource Primary}" CornerRadius="6" Padding="8,3" HasShadow="False">
                                    <Label Text="{Binding Categoria}" TextColor="White" FontSize="11"/>
                                </Frame>
                            </HorizontalStackLayout>

                            <Label Text="{Binding Titulo}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#222222, Dark=White}"/>
                            <Label Text="{Binding Descripcion}" FontSize="13" TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}" LineBreakMode="WordWrap"/>
                            <Label Text="{Binding NombreUsuario, StringFormat='Por: {0}'}" FontSize="12" TextColor="{AppThemeBinding Light=#888888, Dark=#B0BEE8}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>