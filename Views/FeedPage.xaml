<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SkillSwap.ViewModels"
             xmlns:models="clr-namespace:SkillSwap.Models"
             x:Class="SkillSwap.Views.FeedPage"
             x:DataType="vm:FeedViewModel"
             Title="Anuncios"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- Barra superior (Row 0) -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light=#1E2A6E, Dark=#0A0A1A}"
              Padding="10,10,10,10"
              ColumnDefinitions="50, *, 50">

            <Button Grid.Column="0"
                    Text="☰"
                    TextColor="White"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    Clicked="OnMenuClicked"/>

            <Label Grid.Column="1"
                   Text="Anuncios"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Filtro de categorías (Row 1) -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" Margin="12,12,12,0">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categorias}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Text="{Binding .}"
                                BackgroundColor="#3B4CCA"
                                TextColor="White"
                                CornerRadius="20"
                                Padding="14,6"
                                FontSize="12"
                                Clicked="OnCategoriaClicked"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Formulario nuevo/editar anuncio (Row 2) -->
        <Frame Grid.Row="2"
               IsVisible="{Binding MostrandoFormulario}"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
               CornerRadius="12"
               Margin="12,10,12,0"
               Padding="16"
               HasShadow="True"
               BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">
            <VerticalStackLayout Spacing="10">
                <Label Text="Publicar Anuncio"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light=#333, Dark=White}"/>

                <Entry Placeholder="Título del anuncio"
                       Text="{Binding NuevoTitulo}"
                       BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                       TextColor="{AppThemeBinding Light=Black, Dark=White}"
                       PlaceholderColor="{AppThemeBinding Light=#999, Dark=#666}"/>

                <Editor Placeholder="Descripción..."
                        Text="{Binding NuevaDescripcion}"
                        HeightRequest="70"
                        BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                <Picker Title="Categoría"
                        ItemsSource="{Binding Categorias}"
                        SelectedItem="{Binding NuevaCategoria}"
                        TextColor="{AppThemeBinding Light=Black, Dark=White}"
                        TitleColor="{AppThemeBinding Light=#999, Dark=#666}"/>

                <HorizontalStackLayout Spacing="10">
                    <Button Text="Guardar"
                            Command="{Binding GuardarPostCommand}"
                            BackgroundColor="#3B4CCA"
                            TextColor="White"
                            CornerRadius="8"
                            HorizontalOptions="FillAndExpand"/>
                    <Button Text="Cancelar"
                            Command="{Binding CancelarFormularioCommand}"
                            BackgroundColor="{AppThemeBinding Light=#cccccc, Dark=#444444}"
                            TextColor="{AppThemeBinding Light=#333333, Dark=White}"
                            CornerRadius="8"
                            HorizontalOptions="FillAndExpand"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Lista de posts (Row 3) -->
        <CollectionView Grid.Row="3"
                ItemsSource="{Binding Posts}"
                Margin="12,10,12,0"
                BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}">
            <CollectionView.ItemsLayout>
                <!-- Espacio consistente entre items en ambos temas -->
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="No hay anuncios aún. ¡Sé el primero!"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               TextColor="{AppThemeBinding Light=#999999, Dark=#666666}"
               Margin="0,40,0,0"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Post">
                    <!-- Eliminado el margin inferior: el espaciado lo controla ItemSpacing -->
                    <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   CornerRadius="12"
                   Margin="0"
                   Padding="16"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">
                        <VerticalStackLayout Spacing="6">
                            <HorizontalStackLayout Spacing="8">
                                <Frame BackgroundColor="#3B4CCA" CornerRadius="6" Padding="8,3" HasShadow="False">
                                    <Label Text="{Binding Categoria}" TextColor="White" FontSize="11"/>
                                </Frame>
                            </HorizontalStackLayout>

                            <Label Text="{Binding Titulo}"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#222222, Dark=White}"/>

                            <Label Text="{Binding Descripcion}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#555555, Dark=#B0BEE8}"
                           LineBreakMode="WordWrap"/>

                            <Label Text="{Binding NombreUsuario, StringFormat='Por: {0}'}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#888888, Dark=#666666}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Botón publicar (Row 4) -->
        <Button Grid.Row="4"
                Text="+ Publicar anuncio"
                Command="{Binding MostrarFormularioCommand}"
                BackgroundColor="#3B4CCA"
                TextColor="White"
                CornerRadius="10"
                Margin="12,10,12,20"
                HeightRequest="50"
                FontAttributes="Bold"/>

    </Grid>
</ContentPage>
