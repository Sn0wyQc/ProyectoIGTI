<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:SkillSwap.ViewModels" xmlns:models="clr-namespace:SkillSwap.Models" x:Class="SkillSwap.Views.FeedPage" x:DataType="vm:FeedViewModel" Title="Anuncios" BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}">
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Filtro de categorías -->
        <ScrollView Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,0" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categorias}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Text="{Binding .}" CornerRadius="20" Padding="14,6" FontSize="12" BackgroundColor="#3B4CCA" TextColor="White" Clicked="OnCategoriaClicked"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>
        <!-- Formulario nuevo/editar anuncio -->
        <Border Grid.Row="1" IsVisible="{Binding MostrandoFormulario}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" StrokeShape="RoundRectangle 12" Margin="12,10,12,0" Padding="16">
            <VerticalStackLayout Spacing="10">
                <Label Text="Publicar Anuncio" FontAttributes="Bold" FontSize="16"/>
                <Entry Placeholder="Título" Text="{Binding NuevoTitulo}"/>
                <Editor Placeholder="Descripción..." Text="{Binding NuevaDescripcion}" HeightRequest="70"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="Guardar" Command="{Binding GuardarPostCommand}"/>
                    <Button Grid.Column="1" Text="Cancelar" Command="{Binding CancelarFormularioCommand}" BackgroundColor="Red"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
        <CollectionView Grid.Row="2" ItemsSource="{Binding Posts}" Margin="12,10,12,0">
            <CollectionView.EmptyView>
                <Label Text="No hay anuncios aún." HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Post">
                    <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
                            StrokeShape="RoundRectangle 12" Margin="0,0,0,10" Padding="16">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Categoria}" TextColor="#3B4CCA" FontAttributes="Bold" FontSize="11"/>
                            <Label Text="{Binding Titulo}" FontSize="15" FontAttributes="Bold"/>
                            <Label Text="{Binding Descripcion}" FontSize="13" TextColor="#666"/>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <!-- barra horizontal-->
        </CollectionView>
        <Grid Grid.Row="3" HeightRequest="90" VerticalOptions="End" IgnoreSafeArea="True">
            <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 30,30,0,0" 
                    VerticalOptions="End" HeightRequest="70">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,-5" Radius="15" Opacity="0.1"/>

                </Border.Shadow>
                <Grid ColumnDefinitions="*,*,*,*" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="Inicio" HorizontalOptions="Center" TextColor="#3B4CCA" FontAttributes="Bold" FontSize="11"/>
                    <Label Grid.Column="1" Text="Anuncios" HorizontalOptions="Center" TextColor="#888" FontSize="11" Margin="0,0,20,0"/>
                    <Label Grid.Column="2" Text="Mensajes" HorizontalOptions="Center" TextColor="#888" FontSize="11" Margin="20,0,0,0"/>
                    <Label Grid.Column="3" Text="Perfil" HorizontalOptions="Center" TextColor="#888" FontSize="11"/>
                </Grid>
            </Border>
            <!-- Botón flotante para crear nuevo anuncio -->
            <Button Text="+" Command="{Binding MostrarFormularioCommand}" BackgroundColor="#3B4CCA" TextColor="White" 
                    WidthRequest="62" HeightRequest="62" CornerRadius="31" FontSize="28" FontAttributes="Bold" 
                    VerticalOptions="Start" HorizontalOptions="Center">
                <Button.Shadow>
                    <Shadow Brush="#3B4CCA" Offset="0,4" Radius="10" Opacity="0.4"/>
                </Button.Shadow>
            </Button>
        </Grid>
    </Grid>
</ContentPage>