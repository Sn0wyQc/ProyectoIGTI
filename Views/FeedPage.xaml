<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SkillSwap.ViewModels"
             xmlns:models="clr-namespace:SkillSwap.Models"
             x:Class="SkillSwap.Views.FeedPage"
             x:DataType="vm:FeedViewModel"
             Title="Anuncios"
             BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <ScrollView Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,0">
            <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categorias}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Text="{Binding .}"
                                CornerRadius="20"
                                Padding="14,6"
                                FontSize="12"
                                Clicked="OnCategoriaClicked"/>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <Frame Grid.Row="1"
               IsVisible="{Binding MostrandoFormulario}"
               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
               CornerRadius="12"
               Margin="12,10,12,0"
               Padding="16"
               HasShadow="True">
            <VerticalStackLayout Spacing="10">
                <Label Text="Publicar Anuncio"
                       FontAttributes="Bold"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light=#333, Dark=White}"/>

                <Entry Placeholder="Título del anuncio"
                       Text="{Binding NuevoTitulo}"/>

                <Editor Placeholder="Descripción..."
                        Text="{Binding NuevaDescripcion}"
                        HeightRequest="70"/>

                <Picker Title="Categoría"
                        ItemsSource="{Binding Categorias}"
                        SelectedItem="{Binding NuevaCategoria}"
                        TextColor="{AppThemeBinding Light=#333, Dark=White}"
                        TitleColor="{AppThemeBinding Light=#666, Dark=#B0BEE8}"/>

                <HorizontalStackLayout Spacing="10">
                    <Button Text="Guardar"
                            Command="{Binding GuardarPostCommand}"
                            HorizontalOptions="FillAndExpand"/>
                    <Button Text="Cancelar"
                            Command="{Binding CancelarFormularioCommand}"
                            BackgroundColor="{AppThemeBinding Light=#cccccc, Dark=#444444}"
                            TextColor="{AppThemeBinding Light=#333333, Dark=White}"
                            CornerRadius="8"
                            HorizontalOptions="FillAndExpand"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Posts}"
                        Margin="12,10,12,0">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="No hay anuncios aun. Se el primero!"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#999999, Dark=#B0BEE8}"
                       Margin="0,40,0,0"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Post">
                    <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True"
                           BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">
                        <VerticalStackLayout Spacing="6">

                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,5">

                                <Frame Grid.Column="0" HorizontalOptions="Start" BackgroundColor="{StaticResource Primary}" CornerRadius="6" Padding="8,3" HasShadow="False">
                                    <Label Text="{Binding Categoria}" TextColor="White" FontSize="11"/>
                                </Frame>

                                <Label Grid.Column="1" 
                                        Text="&#x22EE;" 
                                        FontSize="22" 
                                        FontAttributes="Bold"
                                        TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                                        VerticalOptions="Center"
                                        Padding="15,0,0,0">
                                     <Label.GestureRecognizers>
                                        <TapGestureRecognizer 
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FeedViewModel}}, Path=MostrarOpcionesCommand}"
                                             CommandParameter="{Binding .}"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>

                            <Label Text="{Binding Titulo}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#222222, Dark=White}"/>

                            <Label Text="{Binding Descripcion}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#555555, Dark=#CCCCCC}"
                                   LineBreakMode="WordWrap"/>

                            <Label Text="{Binding NombreUsuario, StringFormat='Por: {0}'}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#888888, Dark=#B0BEE8}"/>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="3"
                Text="+ Publicar anuncio"
                Command="{Binding MostrarFormularioCommand}"
                Margin="12,10,12,20"
                HeightRequest="50"/>

    </Grid>
</ContentPage>