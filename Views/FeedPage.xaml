<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SkillSwap.ViewModels"
             xmlns:models="clr-namespace:SkillSwap.Models"
             x:Class="SkillSwap.Views.FeedPage"
             x:DataType="vm:FeedViewModel"
             Title="Anuncios"
             BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,80">

            <ScrollView Grid.Row="0" Orientation="Horizontal" Margin="12,12,12,0">
                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Categorias}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Text="{Binding .}"
                                    CornerRadius="20"
                                    Padding="14,6"
                                    FontSize="12"
                                    Clicked="OnCategoriaClicked"/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Frame Grid.Row="1"
                   IsVisible="{Binding MostrandoFormulario}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   CornerRadius="12"
                   Margin="12,10,12,0"
                   Padding="16"
                   HasShadow="True">

                <VerticalStackLayout Spacing="10">
                    <Label Text="Publicar Anuncio"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{AppThemeBinding Light=#333, Dark=White}"/>

                    <Entry Placeholder="Título del anuncio"
                           Text="{Binding NuevoTitulo}"/>

                    <Editor Placeholder="Descripción..."
                            Text="{Binding NuevaDescripcion}"
                            HeightRequest="70"/>

                    <Picker Title="Categoría"
                            ItemsSource="{Binding Categorias}"
                            SelectedItem="{Binding NuevaCategoria}"/>

                    <HorizontalStackLayout Spacing="10">
                        <Button Text="Guardar"
                                Command="{Binding GuardarPostCommand}"
                                HorizontalOptions="FillAndExpand"/>

                        <Button Text="Cancelar"
                                Command="{Binding CancelarFormularioCommand}"
                                BackgroundColor="#cccccc"
                                TextColor="#333333"
                                HorizontalOptions="FillAndExpand"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

            </Frame>

            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Posts}"
                            Margin="12,10,12,0">

                <CollectionView.EmptyView>
                    <Label Text="No hay anuncios aun. Se el primero!"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="0,40,0,0"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Post">
                        <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="12"
                               Margin="0,0,0,10"
                               Padding="16"
                               HasShadow="True">

                            <VerticalStackLayout Spacing="6">

                                <Frame BackgroundColor="{StaticResource Primary}"
                                       CornerRadius="6"
                                       Padding="8,3"
                                       HasShadow="False"
                                       HorizontalOptions="Start">
                                    <Label Text="{Binding Categoria}"
                                           TextColor="White"
                                           FontSize="11"/>
                                </Frame>

                                <Label Text="{Binding Titulo}"
                                       FontSize="15"
                                       FontAttributes="Bold"/>

                                <Label Text="{Binding Descripcion}"
                                       FontSize="13"
                                       LineBreakMode="WordWrap"/>

                                <Label Text="{Binding NombreUsuario, StringFormat='Por: {0}'}"
                                       FontSize="12"/>

                            </VerticalStackLayout>

                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

            <Grid Grid.Row="3" HeightRequest="90">

                <!-- BARRA INFERIOR -->
                <Grid BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                      ColumnDefinitions="*,*,*,*,*"
                      HeightRequest="80"
                      VerticalOptions="End">

                    <ImageButton Grid.Column="0"
                                 Source="hogar.png"
                                 BackgroundColor="Transparent"
                                 Clicked="IrInicio"
                                 WidthRequest="30"
                                 HorizontalOptions="Center"/>

                    <ImageButton Grid.Column="1"
                                 Source="charlando.png"
                                 BackgroundColor="Transparent"
                                 Clicked="IrMensajes"
                                 WidthRequest="30"
                                 HorizontalOptions="Center"/>

                    <BoxView Grid.Column="2" BackgroundColor="Transparent"/>

                    <ImageButton Grid.Column="3"
                                 Source="notificacion.png"
                                 BackgroundColor="Transparent"
                                 Clicked="IrNotificationPage"
                                 WidthRequest="30"
                                 HorizontalOptions="Center"/>

                    <ImageButton Grid.Column="4"
                                 Source="usuario.png"
                                 BackgroundColor="Transparent"
                                 Clicked="IrPerfil"
                                 WidthRequest="30"
                                 HorizontalOptions="Center"/>

                </Grid>

                <!-- BOTÓN + -->
                <Button Text="+"
                        WidthRequest="60"
                        HeightRequest="60"
                        CornerRadius="30"
                        BackgroundColor="#3F51B5"
                        TextColor="White"
                        FontSize="30"
                        HorizontalOptions="Center"
                        VerticalOptions="Start"
                        Margin="0,-30,0,0"
                        Clicked="AgregarPublicacion"/>

            </Grid>

        </Grid>
    </Grid>

</ContentPage>
