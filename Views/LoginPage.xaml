<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SkillSwap.ViewModels"
             x:Class="SkillSwap.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="32,60,32,32" Spacing="0">

            <!-- Header -->
            <Label Text="SkillSwap"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="#3B4CCA"
                   HorizontalOptions="Center"
                   Margin="0,0,0,6"/>

            <Label Text="Exchange. Learn. Grow."
                   FontSize="14"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#B0BEE8}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,40"/>

            <!-- Tarjeta LOGIN -->
            <Frame IsVisible="{Binding MostrandoRegistro, Converter={StaticResource InvertedBoolConverter}}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   CornerRadius="16"
                   HasShadow="True"
                   Padding="24"
                   BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">
                <VerticalStackLayout Spacing="14">

                    <Label Text="Iniciar Sesión"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>

                    <Entry Placeholder="Correo electrónico"
                           Text="{Binding Correo}"
                           Keyboard="Email"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           PlaceholderColor="{AppThemeBinding Light=#999, Dark=#666}"/>

                    <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 6">
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry Grid.Column="0"
                                   Placeholder="Contraseña"
                                   Text="{Binding Password}"
                                   IsPassword="{Binding PasswordOculta}"
                                   ReturnType="Go"
                                   ReturnCommand="{Binding IniciarSesionCommand}"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="{AppThemeBinding Light=#999, Dark=#666}"/>
                            <ImageButton Grid.Column="1"
                                         Source="{Binding IconoPassword}"
                                         Command="{Binding TogglePasswordCommand}"
                                         BackgroundColor="Transparent"
                                         WidthRequest="44"
                                         HeightRequest="44"
                                         Padding="12"
                                         VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#FF5252"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                           FontSize="12"/>

                    <Button Text="Entrar"
                            Command="{Binding IniciarSesionCommand}"
                            BackgroundColor="#3B4CCA"
                            TextColor="White"
                            CornerRadius="10"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#3B4CCA"
                                       HorizontalOptions="Center"/>

                    <Label Text="¿No tienes cuenta? Regístrate"
                           TextColor="#3B4CCA"
                           HorizontalOptions="Center"
                           FontSize="13">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleRegistroCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Frame>

            <!-- Tarjeta REGISTRO -->
            <Frame IsVisible="{Binding MostrandoRegistro}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   CornerRadius="16"
                   HasShadow="True"
                   Padding="24"
                   BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Crear Cuenta"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#333333, Dark=White}"/>

                    <Entry Placeholder="Nombre completo"
                           Text="{Binding RegNombre}"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           PlaceholderColor="{AppThemeBinding Light=#999, Dark=#666}"/>

                    <Entry Placeholder="Correo electrónico"
                           Text="{Binding RegCorreo}"
                           Keyboard="Email"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           PlaceholderColor="{AppThemeBinding Light=#999, Dark=#666}"/>

                    <Border BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 6">
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry Grid.Column="0"
                                   Placeholder="Contraseña (mín. 6 caracteres)"
                                   Text="{Binding RegPassword}"
                                   IsPassword="{Binding RegPasswordOculta}"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                   PlaceholderColor="{AppThemeBinding Light=#999, Dark=#666}"/>
                            <ImageButton Grid.Column="1"
                                         Source="{Binding IconoRegPassword}"
                                         Command="{Binding ToggleRegPasswordCommand}"
                                         BackgroundColor="Transparent"
                                         WidthRequest="44"
                                         HeightRequest="44"
                                         Padding="12"
                                         VerticalOptions="Center"/>
                        </Grid>
                    </Border>

                    <Editor Placeholder="Descripción breve de ti..."
                            Text="{Binding RegDescripcion}"
                            HeightRequest="70"
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

                    <Entry Placeholder="Tus habilidades (ej: Python, Guitarra)"
                           Text="{Binding RegHabilidades}"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                           TextColor="{AppThemeBinding Light=Black, Dark=White}"
                           PlaceholderColor="{AppThemeBinding Light=#999, Dark=#666}"/>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="#FF5252"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                           FontSize="12"/>

                    <Button Text="Registrarme"
                            Command="{Binding RegistrarCommand}"
                            BackgroundColor="#3B4CCA"
                            TextColor="White"
                            CornerRadius="10"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#3B4CCA"
                                       HorizontalOptions="Center"/>

                    <Label Text="¿Ya tienes cuenta? Inicia sesión"
                           TextColor="#3B4CCA"
                           HorizontalOptions="Center"
                           FontSize="13">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleRegistroCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
