<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SkillSwap.ViewModels"
             x:Class="SkillSwap.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}"
             Shell.NavBarIsVisible="True"
             Shell.FlyoutBehavior="Disabled">

    <ScrollView>
        <VerticalStackLayout Padding="32,60,32,32" Spacing="0">

            <Label Text="SkillSwap"
                   FontSize="36"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#3B4CCA, Dark=#B0BEE8}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,6"/>

            <Label Text="Exchange. Learn. Grow"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#B0BEE8}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,40"/>

            <Frame IsVisible="{Binding MostrandoRegistro, Converter={StaticResource InvertedBoolConverter}}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   CornerRadius="16"
                   HasShadow="True"
                   Padding="24">
                <VerticalStackLayout Spacing="14">

                    <Label Text="Iniciar Sesión" Style="{StaticResource TitleLabel}"/>

                    <Entry Placeholder="Correo electronico"
                           Text="{Binding Correo}"
                           Keyboard="Email"/>

                    <Grid ColumnDefinitions="*, Auto" 
                          BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}">
                        <Entry Placeholder="Contraseña" 
                               Text="{Binding Password}" 
                               IsPassword="{Binding IsPasswordHidden}" 
                               Grid.Column="0" VerticalOptions="Center"
                               BackgroundColor="Transparent"/>
                        <ImageButton Source="{Binding PasswordIcon}" 
                                     Command="{Binding TogglePasswordCommand}"
                                     Grid.Column="1" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent"/>
                    </Grid>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                           FontSize="12"/>

                    <Button Text="Entrar"
                            Command="{Binding IniciarSesionCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#3B4CCA"
                                       HorizontalOptions="Center"/>

                    <Label Text="No tienes cuenta? Registrate"
                           TextColor="#3B4CCA"
                           HorizontalOptions="Center"
                           FontSize="13">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleRegistroCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Frame>

            <Frame IsVisible="{Binding MostrandoRegistro}"
                   BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   CornerRadius="16"
                   HasShadow="True"
                   Padding="24">
                <VerticalStackLayout Spacing="12">

                    <Label Text="Crear Cuenta" Style="{StaticResource TitleLabel}"/>

                    <Entry Placeholder="Nombre completo"
                           Text="{Binding RegNombre}"/>

                    <Entry Placeholder="Correo electronico"
                           Text="{Binding RegCorreo}"
                           Keyboard="Email"/>

                    <Grid ColumnDefinitions="*, Auto" 
                          BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}">
                        <Entry Placeholder="Contrasena" 
                               Text="{Binding RegPassword}" 
                               IsPassword="{Binding IsPasswordHidden}" 
                               Grid.Column="0" VerticalOptions="Center"
                               BackgroundColor="Transparent"/>
                        <ImageButton Source="{Binding PasswordIcon}" 
                                     Command="{Binding TogglePasswordCommand}"
                                     Grid.Column="1" WidthRequest="40" HeightRequest="40" BackgroundColor="Transparent"/>
                    </Grid>

                    <Editor Placeholder="Descripcion breve de ti..."
                            Text="{Binding RegDescripcion}"
                            HeightRequest="70"/>

                    <Entry Placeholder="Tus habilidades (ej: Python, Guitarra)"
                           Text="{Binding RegHabilidades}"/>

                    <Label Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                           FontSize="12"/>

                    <Button Text="Registrarme"
                            Command="{Binding RegistrarCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#3B4CCA"
                                       HorizontalOptions="Center"/>

                    <Label Text="Ya tienes cuenta? Inicia sesion"
                           TextColor="#3B4CCA"
                           HorizontalOptions="Center"
                           FontSize="13">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleRegistroCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>