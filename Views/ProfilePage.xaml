<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SkillSwap.ViewModels"
             xmlns:models="clr-namespace:SkillSwap.Models"
             x:Class="SkillSwap.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Mi Perfil"
             BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">

            <Frame BackgroundColor="{StaticResource Primary}"
                   CornerRadius="50"
                   HeightRequest="80"
                   WidthRequest="80"
                   HorizontalOptions="Center"
                   HasShadow="True"
                   Padding="0">
                <Label Text="👤"
                       FontSize="36"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
            </Frame>

            <Label Text="{Binding Correo}"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#666, Dark=#B0BEE8}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10"/>

            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                   CornerRadius="14"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Información Personal"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#333, Dark=White}"/>

                    <Label Text="Nombre" FontSize="12" TextColor="{AppThemeBinding Light=#888, Dark=#B0BEE8}"/>
                    <Entry Text="{Binding Nombre}"
                           Placeholder="Tu nombre"/>

                    <Label Text="Descripción" FontSize="12" TextColor="{AppThemeBinding Light=#888, Dark=#B0BEE8}"/>
                    <Editor Text="{Binding Descripcion}"
                            HeightRequest="80"
                            Placeholder="Cuéntanos sobre ti..."/>

                    <Label Text="Habilidades" FontSize="12" TextColor="{AppThemeBinding Light=#888, Dark=#B0BEE8}"/>
                    <Entry Text="{Binding Habilidades}"
                           Placeholder="Python, Guitarra, Inglés..."/>

                    <Label Text="{Binding MensajeEstado}"
                           TextColor="#388E3C"
                           IsVisible="{Binding MensajeEstado, Converter={StaticResource StringNotEmptyConverter}}"
                           FontSize="12"/>

                    <Button Text="Guardar cambios"
                            Command="{Binding GuardarPerfilCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="#3B4CCA"
                                       HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Mis Publicaciones"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#333, Dark=White}"
                   Margin="0,10,0,0"/>

            <CollectionView ItemsSource="{Binding MisPublicaciones}">
                <CollectionView.EmptyView>
                    <Label Text="Aún no tienes publicaciones."
                           TextColor="{AppThemeBinding Light=#999, Dark=#666}"
                           FontSize="13"
                           HorizontalOptions="Center"
                           Margin="0,10,0,0"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Post">
                        <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               CornerRadius="10"
                               Margin="0,0,0,8"
                               Padding="14"
                               HasShadow="True"
                               BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">
                            <VerticalStackLayout>
                                <Label Text="{Binding Titulo}"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#222, Dark=White}"
                                       FontSize="14"/>
                                <Label Text="{Binding Categoria}"
                                       TextColor="{AppThemeBinding Light=#888, Dark=#B0BEE8}"
                                       FontSize="12"/>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Cerrar sesión"
                    Command="{Binding CerrarSesionCommand}"
                    BackgroundColor="#FF5252"
                    TextColor="White"
                    CornerRadius="10"
                    Margin="0,10,0,20"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>