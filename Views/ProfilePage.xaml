<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SkillSwap.ViewModels"
             xmlns:models="clr-namespace:SkillSwap.Models"
             x:Class="SkillSwap.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="Mi Perfil"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F0F4FF, Dark=#121212}">

    <Grid RowDefinitions="Auto, *">

        <!-- Barra superior (Row 0) -->
        <Grid Grid.Row="0"
              BackgroundColor="{AppThemeBinding Light=#1E2A6E, Dark=#0A0A1A}"
              Padding="10,10,10,10"
              ColumnDefinitions="50, *, 50">

            <Button Grid.Column="0"
                    Text="☰"
                    TextColor="White"
                    FontSize="24"
                    BackgroundColor="Transparent"
                    Clicked="OnMenuClicked"/>

            <Label Grid.Column="1"
                   Text="Mi Perfil"
                   TextColor="White"
                   FontSize="18"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- Contenido (Row 1) -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="14">

                <!-- Foto de perfil -->
                <Grid HorizontalOptions="Center" WidthRequest="110" HeightRequest="110">

                    <!-- Avatar por defecto -->
                    <Border StrokeThickness="2"
                            Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#444444}"
                            HeightRequest="110" WidthRequest="110"
                            IsVisible="{Binding TieneFoto, Converter={StaticResource InvertedBoolConverter}}"
                            HorizontalOptions="Center"
                            Padding="0"
                            BackgroundColor="#3B4CCA">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="100"/>
                        </Border.StrokeShape>
                        <Label Text="👤"
                               FontSize="48"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </Border>

                    <!-- Foto real -->
                    <Border StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#CCCCCC, Dark=#444444}"
                            HeightRequest="110" WidthRequest="110"
                            IsVisible="{Binding TieneFoto}"
                            HorizontalOptions="Center"
                            Padding="0" Margin="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="100"/>
                        </Border.StrokeShape>
                        <Image Source="{Binding FotoPerfil}"
                               Aspect="AspectFill"
                               HeightRequest="110"
                               WidthRequest="110"
                               Margin="0"/>
                    </Border>
                </Grid>

                <!-- Botones foto -->
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Button Text="Cambiar foto"
                            FontSize="12"
                            Clicked="OnCambiarFotoClicked"/>
                    <Button Text="Eliminar foto"
                            Command="{Binding EliminarFotoPerfilCommand}"
                            FontSize="12"
                            BackgroundColor="#CC3333"
                            IsVisible="{Binding TieneFoto}"/>
                </HorizontalStackLayout>

                <!-- Correo -->
                <Label Text="{Binding Correo}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#666, Dark=#B0BEE8}"
                       HorizontalOptions="Center"
                       Margin="0,0,0,10"/>

                <!-- Tarjeta edición -->
                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                       CornerRadius="14"
                       Padding="20"
                       HasShadow="True"
                       BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">
                    <VerticalStackLayout Spacing="12">

                        <Label Text="Información Personal"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=White}"/>

                        <Label Text="Nombre" FontSize="12"
                               TextColor="{AppThemeBinding Light=#888, Dark=#B0BEE8}"/>
                        <Entry Text="{Binding Nombre}"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               Placeholder="Tu nombre"/>

                        <Label Text="Descripción" FontSize="12"
                               TextColor="{AppThemeBinding Light=#888, Dark=#B0BEE8}"/>
                        <Editor Text="{Binding Descripcion}"
                                HeightRequest="80"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                                TextColor="{AppThemeBinding Light=Black, Dark=White}"
                                Placeholder="Cuéntanos sobre ti..."/>

                        <Label Text="Habilidades" FontSize="12"
                               TextColor="{AppThemeBinding Light=#888, Dark=#B0BEE8}"/>
                        <Entry Text="{Binding Habilidades}"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               Placeholder="Python, Guitarra, Inglés..."/>

                        <Label Text="{Binding MensajeEstado}"
                               TextColor="#388E3C"
                               IsVisible="{Binding MensajeEstado, Converter={StaticResource StringNotEmptyConverter}}"
                               FontSize="12"/>

                        <Button Text="Guardar cambios"
                                Command="{Binding GuardarPerfilCommand}"
                                BackgroundColor="#3B4CCA"
                                TextColor="White"
                                CornerRadius="10"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}"/>

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="#3B4CCA"
                                           HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Mis publicaciones -->
                <Label Text="Mis Publicaciones"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#333, Dark=White}"
                       Margin="0,10,0,0"/>

                <CollectionView ItemsSource="{Binding MisPublicaciones}">
                    <CollectionView.EmptyView>
                        <Label Text="Aún no tienes publicaciones."
                               TextColor="{AppThemeBinding Light=#999, Dark=#666}"
                               FontSize="13"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Post">
                            <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                                   CornerRadius="10"
                                   Margin="0,0,0,8"
                                   Padding="14"
                                   HasShadow="True"
                                   BorderColor="{AppThemeBinding Light=Transparent, Dark=#333333}">
                                <VerticalStackLayout>
                                    <Label Text="{Binding Titulo}"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#222, Dark=White}"
                                           FontSize="14"/>
                                    <Label Text="{Binding Categoria}"
                                           TextColor="{AppThemeBinding Light=#888, Dark=#B0BEE8}"
                                           FontSize="12"/>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Cerrar sesión -->
                <Button Text="Cerrar sesión"
                        Command="{Binding CerrarSesionCommand}"
                        BackgroundColor="#FF5252"
                        TextColor="White"
                        CornerRadius="10"
                        Margin="0,10,0,20"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
