<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               xmlns:vm="clr-namespace:SkillSwap.ViewModels"
               x:Class="SkillSwap.Views.OpcionesAnuncioPopup"
               x:DataType="vm:OpcionesAnuncioViewModel"
               Color="Transparent">

    <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
           CornerRadius="20" Padding="20" WidthRequest="280" HasShadow="True">

        <VerticalStackLayout Spacing="10">
            <Label Text="Opciones" FontAttributes="Bold" FontSize="18" 
                   HorizontalOptions="Center" Margin="0,0,0,10"
                   TextColor="{AppThemeBinding Light=#3B4CCA, Dark=White}"/>

            <Button Text="Editar Anuncio" Command="{Binding SeleccionarOpcionCommand}" CommandParameter="Editar"
                    IsVisible="{Binding EsPropio}" 
                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

            <Button Text="Eliminar Anuncio" Command="{Binding SeleccionarOpcionCommand}" CommandParameter="Eliminar"
                    IsVisible="{Binding EsPropio}" 
                    BackgroundColor="#E53935" TextColor="White" CornerRadius="10"/>

            <Button Text="Guardar Anuncio" Command="{Binding SeleccionarOpcionCommand}" CommandParameter="Guardar"
                    IsVisible="{Binding EsAjeno}" 
                    BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Black, Dark=White}"/>

            <Button Text="Reportar Anuncio" Command="{Binding SeleccionarOpcionCommand}" CommandParameter="Reportar"
                    IsVisible="{Binding EsAjeno}" 
                    BackgroundColor="#E53935" TextColor="White" CornerRadius="10"/>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#EEEEEE, Dark=#333333}" Margin="0,5"/>

            <Button Text="Cancelar" Command="{Binding SeleccionarOpcionCommand}" CommandParameter="Cancelar"
                    BackgroundColor="Transparent" TextColor="Gray"/>
        </VerticalStackLayout>
    </Frame>
</toolkit:Popup>