<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="SkillSwap.Views.ConfirmacionPopup"
               Color="Transparent">

    <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" 
           CornerRadius="20" 
           Padding="24"
           WidthRequest="320"
           HasShadow="True">

        <VerticalStackLayout Spacing="20">
            <Label Text="{Binding Titulo}" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#3B4CCA, Dark=White}"/>

            <Label Text="{Binding Mensaje}" HorizontalOptions="Center" HorizontalTextAlignment="Center" TextColor="{AppThemeBinding Light=#666, Dark=#B0BEE8}"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="15" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="No" 
                        Command="{Binding NoCommand}" 
                        BackgroundColor="Transparent" TextColor="#3B4CCA" 
                        BorderColor="#3B4CCA" BorderWidth="1" CornerRadius="12"/>

                <Button Grid.Column="1" Text="Sí" 
                        Command="{Binding SiCommand}" 
                        BackgroundColor="#E53935" TextColor="White" CornerRadius="12"/>
            </Grid>
        </VerticalStackLayout>
    </Frame>
</toolkit:Popup>