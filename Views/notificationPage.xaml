<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             x:Name="Page"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:SkillSwap.Converters"
             x:Class="SkillSwap.Views.NotificationPage"
             BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#121212}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:BoolToColorConverter x:Key="BoolToColorConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="20" RowSpacing="15">

        <!-- HEADER -->
        <Label Text="Notificaciones"
               FontSize="32"
               FontAttributes="Bold"
               TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>

        <!-- LISTA -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Notificaciones}"
                        SelectionMode="None">

            <CollectionView.ItemTemplate>
                <DataTemplate>


                    <SwipeView>

                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">

                                <!-- ELIMINAR -->
                                <SwipeItem Text="Eliminar"
                                           BackgroundColor="#EF4444"
                                           Command="{Binding BindingContext.EliminarCommand, Source={x:Reference Page}}"
                                           CommandParameter="{Binding .}" />

                                <!--  MARCAR LEÍDA -->
                                <SwipeItem Text="Leída"
                                           BackgroundColor="#4F46E5"
                                           Command="{Binding BindingContext.MarcarLeidaCommand, Source={x:Reference Page}}"
                                           CommandParameter="{Binding .}" />

                            </SwipeItems>
                        </SwipeView.RightItems>

                        <!-- CARD -->
                        <Frame CornerRadius="18"
                               Padding="16"
                               Margin="0,5"
                               HasShadow="False"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}"
                               BorderColor="{AppThemeBinding Light=#E5E7EB, Dark=#2A2A2A}">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <!-- ICONO -->
                                <Frame WidthRequest="40"
                                       HeightRequest="40"
                                       CornerRadius="20"
                                       Padding="8"
                                       HasShadow="False"
                                       BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#2C2C3A}">

                                    <Image Source="dotnet_bot.png"/>
                                </Frame>

                                <!-- TEXTO -->
                                <VerticalStackLayout Grid.Column="1" Spacing="2">

                                    <Label Text="{Binding Titulo}"
                                           FontAttributes="Bold"
                                           FontSize="15"
                                           TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>

                                    <Label Text="{Binding Mensaje}"
                                           FontSize="13"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}"/>
                                </VerticalStackLayout>


                                <VerticalStackLayout Grid.Column="2"
                                                     HorizontalOptions="End"
                                                     Spacing="6">

                                    <Label Text="{Binding Fecha}"
                                           FontSize="11"
                                           TextColor="{AppThemeBinding Light=#9CA3AF, Dark=#71717A}"/>


                                    <BoxView WidthRequest="8"
                                             HeightRequest="8"
                                             CornerRadius="4"
                                             BackgroundColor="#4F46E5"
                                             IsVisible="{Binding NoLeida}"
                                             HorizontalOptions="End"/>

                                    <!--  OPCIONES -->
                                    <Button Text="⋮"
                                            FontSize="18"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A1AA}"
                                            Command="{Binding BindingContext.OpcionesCommand, Source={x:Reference Page}}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>

                            </Grid>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding BindingContext.AbrirDetalleCommand, Source={x:Reference Page}}"
                                    CommandParameter="{Binding .}"/>
                            </Frame.GestureRecognizers>

                        </Frame>

                    </SwipeView>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>
</ContentPage>